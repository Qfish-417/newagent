# UTF-8 file. Format: NAME=value (no export, no $env:, no JSON).
# Required: DEEPSEEK_API_KEY in your system environment (recommended).
# Or uncomment the next line and fill it ONLY in your local .env:
# DEEPSEEK_API_KEY=

# Optional: defaults below normally need no changes.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATA_DIR=data
MAX_ROUNDS=12

# Optional Tavily provider. Empty means use DeepSeek official search directly.
SEARCH_API_KEY=
